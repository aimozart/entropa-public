# Copy this file to .env and fill in your own local-only values before
# running `docker compose up`. .env is gitignored — never commit it.
# None of these protect anything real; they're throwaway credentials for
# containers that only run on your own machine.

POSTGRES_PASSWORD=change-me-locally
KEYCLOAK_ADMIN_PASSWORD=change-me-locally
KEYCLOAK_SERVICE_CLIENT_SECRET=change-me-locally
