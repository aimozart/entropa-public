# Copy to .env for local dev. All values here are fake placeholders — never put real
# credentials in this file (it's tracked in git; .env itself is gitignored).

# Unset entirely = runs fully offline: in-memory chain, no Firestore persistence.
GCP_PROJECT=my-test-project

# "name1:key1,name2:key2" - unset = /api/tx stays open (public demo default).
ENTROPA_API_KEYS=acme:fake-dev-key-not-real
